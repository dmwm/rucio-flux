+"""
+FTS3 transfertool with SENSE network routing.
+
+DMM (the SENSE Data Movement Manager) provisions a network circuit per rule and
+assigns the rule its own endpoint at each end. FTS link limits are configured on
+those endpoints, so the source and destination URLs handed to FTS have to name
+them instead of the storage's usual host. The rewrite happens only in the FTS
+job: Rucio keeps the original URLs in its database.
+"""
+
+import logging
+from typing import TYPE_CHECKING, Any, Optional
+from urllib.parse import urlparse, urlunparse
+
+import requests
+
+from rucio.common.config import config_get
+from rucio.transfertool.fts3 import FTS3Transfertool
+
+if TYPE_CHECKING:
+    from collections.abc import Sequence
+
+    from rucio.core.request import DirectTransfer
+
+DMM_TIMEOUT = 5
+
+
+def _replace_netloc(url: str, netloc: str) -> str:
+    return urlunparse(urlparse(url)._replace(netloc=netloc))
+
+
+class SenseFTS3Transfertool(FTS3Transfertool):
+    """
+    FTS3Transfertool which routes transfers of SENSE rules over their circuit.
+
+    It keeps the 'fts3' external name, so it can replace FTS3Transfertool in the
+    transfertool registry without touching requests, RSE attributes or daemon
+    options. With no [dmm] url configured it only adds rule_id to the file metadata.
+    """
+
+    def __init__(self, external_host: str, *args, **kwargs):
+        super().__init__(external_host, *args, **kwargs)
+        self.dmm_url = config_get('dmm', 'url', False, None)
+        activities = config_get('dmm', 'activities', False, 'sense test')
+        self.sense_activities = {activity.strip().lower() for activity in activities.split(',')}
+        # rule_id -> DMM allocation, or None when DMM has none. An instance lives
+        # for one submission cycle, so this never outlasts an allocation for long.
+        self.dmm_allocations: dict[str, Optional[dict[str, str]]] = {}
+        self.dmm_unavailable = False
+
+    def submit(self, transfers: "Sequence[DirectTransfer]", job_params: dict[str, str], timeout: Optional[int] = None) -> str:
+        self._fetch_dmm_allocations(transfers)
+        return super().submit(transfers, job_params, timeout)
+
+    def _file_from_transfer(self, transfer: "DirectTransfer", job_params: dict[str, str]) -> dict[str, Any]:
+        t_file = super()._file_from_transfer(transfer, job_params)
+        # DMM finds the transfers of a rule in FTS monitoring by this field
+        t_file['metadata']['rule_id'] = transfer.rws.rule_id
+
+        allocation = self.dmm_allocations.get(transfer.rws.rule_id)
+        if allocation:
+            self._route_over_sense(transfer, t_file, allocation)
+        return t_file
+
+    def _is_sense_transfer(self, transfer: "DirectTransfer") -> bool:
+        return bool(transfer.rws.rule_id) and (transfer.rws.activity or '').lower() in self.sense_activities
+
+    def _fetch_dmm_allocations(self, transfers: "Sequence[DirectTransfer]") -> None:
+        """
+        Ask DMM, in one request, for the allocations of all SENSE rules in this job.
+        """
+        if not self.dmm_url or self.dmm_unavailable:
+            return
+
+        rule_ids = sorted({t.rws.rule_id for t in transfers if self._is_sense_transfer(t)} - self.dmm_allocations.keys())
+        if not rule_ids:
+            return
+
+        try:
+            response = requests.get(f'{self.dmm_url}/query', params={'rule_id': rule_ids}, timeout=DMM_TIMEOUT)
+            response.raise_for_status()
+            allocations = response.json()
+            if not isinstance(allocations, dict):
+                raise ValueError(f'expected a JSON object, got {type(allocations).__name__}')
+        except (requests.RequestException, ValueError) as error:
+            # One slow or dead DMM must not stall every job of the cycle
+            self.dmm_unavailable = True
+            self.logger(logging.WARNING, 'DMM query failed, submitting without SENSE routing for the rest of this cycle: %s', error)
+            return
+
+        for rule_id in rule_ids:
+            allocation = allocations.get(rule_id)
+            if isinstance(allocation, dict) and all(isinstance(allocation.get(key), str) for key in ('source', 'destination', 'src_rse', 'dst_rse')):
+                self.dmm_allocations[rule_id] = allocation
+                self.logger(logging.DEBUG, 'DMM allocation for rule %s: %s -> %s', rule_id, allocation['source'], allocation['destination'])
+            else:
+                self.dmm_allocations[rule_id] = None
+                self.logger(logging.INFO, 'No DMM allocation for rule %s yet, submitting without SENSE routing', rule_id)
+
+    def _route_over_sense(self, transfer: "DirectTransfer", t_file: dict[str, Any], allocation: dict[str, str]) -> None:
+        """
+        Point the source and destination URLs of the file at the rule's SENSE endpoints.
+        """
+        src_rse, dst_rse = transfer.src.rse.name, transfer.dst.rse.name
+        # The circuit only joins the two RSEs DMM allocated it for (a multihop leg, for instance, doesn't qualify)
+        if (src_rse, dst_rse) != (allocation['src_rse'], allocation['dst_rse']):
+            self.logger(logging.WARNING, 'SENSE allocation for rule %s is %s -> %s, not rerouting transfer %s -> %s of request %s',
+                        transfer.rws.rule_id, allocation['src_rse'], allocation['dst_rse'], src_rse, dst_rse, transfer.rws.request_id)
+            return
+
+        old_src, old_dst = t_file['sources'][0], t_file['destinations'][0]
+        t_file['sources'][0] = _replace_netloc(old_src, allocation['source'])
+        t_file['destinations'][0] = _replace_netloc(old_dst, allocation['destination'])
+        self.logger(logging.INFO, 'SENSE routing request %s of rule %s: %s -> %s, %s -> %s',
+                    transfer.rws.request_id, transfer.rws.rule_id, old_src, t_file['sources'][0], old_dst, t_file['destinations'][0])
